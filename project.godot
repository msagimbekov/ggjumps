; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="99 jumps"
config/version="0.1.8"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://ui/icons/ios_1024.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.28, 0.45, 1)

[autoload]

Ota="*res://scripts/ota.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/share/plugin.cfg")

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.28, 0.45, 1)
